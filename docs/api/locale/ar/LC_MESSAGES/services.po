msgstr ""

#: ../../services.rst:612 460eb44339f240e5980575564e62513f
msgid "``services.sync``"
msgstr ""

#: ../../services.rst:614 61aad4abe5694c08b520e2f79f437b1b
msgid ""
"Configuration files to database - the only package here that touches the "
"ORM."
msgstr ""

#: ../../services.rst:619 apps.libraries.services.sync.service:1
#: b28dc860b8af4f37b358c409bd9838e4 c43bb86aa618411eab2b37e8170e6613 of
msgid "Configuration files to database."
msgstr ""

#: apps.libraries.services.sync.service:3 c113e738fac94c04be2bffe66c37eb83 of
msgid ""
"Moved from services/sync_service.py. It read device.conf through the old "
"library adapter, which answered an unreadable file with an empty list - "
"and an empty list here deactivates every library in the database. It "
"reads the file through ConfigService now, and an unreadable file is an "
"error."
msgstr ""

#: 91ac125671ef4302a852e19f51062cf2 apps.libraries.services.sync.service:8 of
msgid ""
"This is the one module in services permitted to import "
"apps.libraries.models, and the boundary is deliberate: the config files "
"are authoritative and the database is a cache of them. Everything else in"
" the layer stays ORM-free so the CLI can call it without Django's app "
"registry being loaded."
msgstr ""

#: 50c2daabf9184a6d8cfae4f43c9df437 apps.libraries.services.sync.service:17 of
msgid ""
"only sync/ may import apps.libraries.models  <- this module is the "
"exception"
msgstr ""

#: apps.libraries.services.sync.service.ConfigUnreadable:1
#: da7f761d439846d782610a071beecde9 of
msgid "device.conf could not be read; nothing was changed."
msgstr ""

#: 580f1058e3cf41a29ec314a11aee34a4
#: apps.libraries.services.sync.service.sync_mhvtl_to_django:1 of
msgid "Sync MHVTL device.conf into the Django database."
msgstr ""

#: 36e76e2590a2456eb9d5d5986bfcccbb
#: apps.libraries.services.sync.service.sync_mhvtl_to_django:3 of
msgid "Creates Library and Drive records for MHVTL libraries not yet in the DB."
msgstr ""

#: 40063f3739344e6cb61b0ce306bb22a6
#: apps.libraries.services.sync.service.sync_mhvtl_to_django:4 of
msgid "Activates DB libraries that exist in device.conf but are inactive."
msgstr ""

#: 4fbc007ae51445478455a0222c6ebc17
#: apps.libraries.services.sync.service.sync_mhvtl_to_django:5 of
msgid "Deactivates DB libraries that are active but missing from device.conf."
msgstr ""

#: 6ee0dd25a16a425a8cdd9a571870b2df
#: apps.libraries.services.sync.service.sync_mhvtl_to_django:6 of
msgid ""
"Brings an existing row back in line with device.conf. A library deleted "
"and recreated keeps its id, so the row described the library that used to"
" have that id - the wrong vendor, product, brand and SCSI address on "
"every page that reads the database."
msgstr ""

#: 0f1307f32794440cb637ca6ab2899121
#: apps.libraries.services.sync.service.sync_mhvtl_to_django:10 of
msgid ""
"For every library device.conf declares, makes its database drives match: "
"missing ones are created, inactive ones reactivated, ones device.conf no "
"longer lists deactivated. It used to import drives only when it created "
"the library, so a library deleted and recreated kept its drives inactive "
"and the drive pages showed none."
msgstr ""

#: 4cf385ecf5064f8aabd8c4ba725873c3
#: apps.libraries.services.sync.service.sync_mhvtl_to_django of
msgid "Returns"
msgstr ""

#: 706f57905fc6461a8a487073507dee59
#: apps.libraries.services.sync.service.sync_mhvtl_to_django:16 of
msgid ""
"libraries_found, created, updated, drives_imported, drives_activated, "
"drives_deactivated, activated, deactivated, total_db, total_drives"
msgstr ""

#: ac1338a4c48d4e29adb40fb269498a37
#: apps.libraries.services.sync.service.sync_mhvtl_to_django of
msgid "Return type"
msgstr ""

#: 67129770d1394d29b01b2698c84d09be
#: apps.libraries.services.sync.service.sync_mhvtl_to_django:21 of
msgid ""
"Raises ConfigUnreadable, and changes nothing, when device.conf cannot be "
"read."
msgstr ""

