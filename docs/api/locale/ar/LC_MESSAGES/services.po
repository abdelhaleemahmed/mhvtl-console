#: ../../services.rst:91 360aaaf1bd3542398e34e132623e9e6e
msgid "``ids``"
msgstr ""

#: ../../services.rst:93 357cefb7a9644cf2ba56f193de5becf8
#: apps.libraries.services.config.ids:1 f9cbe56178a24a4b8ae28214a5d10ef2 of
msgid "Handing out library ids, drive ids and SCSI targets."
msgstr ""

#: 47c7ff46442c427cb3f0265ac5e0d84b apps.libraries.services.config.ids:3 of
msgid ""
"MHVTL puts every library and every drive in one id namespace: the id is "
"the daemon's message queue id and the kernel minor number, and both "
"daemons refuse anything at or above 1024 (see "
"profiles/personalities.MAX_DEVICE_ID for the source lines). A drive's id "
"does not have to relate to its library's - the drive's `Library ID: N "
"Slot: M` line is what ties it to the library (usr/cmd/vtllibrary.c:634) -"
" so the only hard rule is that no two devices share an id."
msgstr ""

#: 3ebe2c964cca428189ff72be028f3eca apps.libraries.services.config.ids:11 of
msgid "The conventions this module keeps on top of that rule are for people::"
msgstr ""

#: apps.libraries.services.config.ids:19 cace6351150b466992ee5e326298c9fb of
msgid ""
"The previous allocators used library id + slot unconditionally and "
"checked it only against other drives, so a tenth drive on library 10 was "
"given id 20 - library 20's id."
msgstr ""

#: 5cbc9890a8ba42d39fa84cc39bd1b22e apps.libraries.services.config.ids:23 of
msgid ""
"Targets: one per device, LUN 0. MHVTL itself sets no target limit (the "
"daemons parse TARGET unchecked and __scsi_add_device ignores the host's "
"max_id); MAX_TARGET in device_conf caps it at 99 so the NAA line keeps "
"two-digit fields."
msgstr ""

#: 8173e383d50c437ea9963a21389d3f07
#: apps.libraries.services.config.ids.LIBRARY_STEP:1 of
msgid "Library ids are multiples of this, and drive ids avoid them."
msgstr ""

#: apps.libraries.services.config.ids.OutOfIds:1
#: ee6fbb0238d1459b9ad3a636fc56f859 of
msgid "No id or target is left for what was asked."
msgstr ""

#: 87d595a9dc3a487682484eb1bb4d5a04
#: apps.libraries.services.config.ids.used_ids:1 of
msgid "Every id device.conf already gives a library or a drive."
msgstr ""

#: 58ddd6be865a4c4a8b56926f04de67b1
#: apps.libraries.services.config.ids.next_library_id:1 of
msgid "The lowest free multiple of `step`, or None when there is none."
msgstr ""

#: 5419261336434e64850988aa9c3f941b
#: apps.libraries.services.config.ids.next_library_id:3 of
msgid ""
"Free means used by neither a library nor a drive: a drive that took id 40"
" before this rule existed makes 40 unavailable as a library id."
msgstr ""

#: 95b8b46e26584cf2b492ee4321ed762d
#: apps.libraries.services.config.ids.drive_ids:1 of
msgid "An id for each slot, preferring library id + slot."
msgstr ""

#: apps.libraries.services.config.ids.drive_ids:3
#: f2f7ebe2dbfc46cda295911fffb49cce of
msgid ""
"`reserved` holds ids already promised in the same operation - the "
"library's own id when it is being created. Raises OutOfIds when the "
"namespace runs out, naming how many were wanted."
msgstr ""

#: 626a82e0cc8f4fdb97fa676c25beaed1
#: apps.libraries.services.config.ids.free_targets:1 of
msgid ""
"How many SCSI targets are left: a new library needs one for itself and "
"one per drive, so this less one is the most drives it can have."
msgstr ""

#: 816c2cb85d044444a22acc03cfeac489
#: apps.libraries.services.config.ids.targets:1 of
msgid "`count` free SCSI targets, contiguous if possible."
msgstr ""

#: 3944d6d2f1584ab78b450c59d22d2361
#: apps.libraries.services.config.ids.targets:3 of
msgid ""
"Contiguous above the highest target in use first, which keeps one "
"library's devices together the way the existing allocation did; then "
"contiguous anywhere; then any free targets at all, since MHVTL does not "
"need them together. Raises OutOfIds when fewer than `count` are free "
"below MAX_TARGET."
msgstr ""

#: 89fd9e520dbb4203a86b03708a351b70
#: apps.libraries.services.config.ids.plan_library:1 of
msgid ""
"Everything a new library needs: (library target, drive ids, drive "
"targets)."
msgstr ""

#: 662dad94cfd44e2290cd17336ce239a1
#: apps.libraries.services.config.ids.plan_library:3 of
msgid "Raises OutOfIds if any of it cannot be had, before anything is written."
msgstr ""

#: 4fe51c013b4b4792b3e97f741fdecc61
#: apps.libraries.services.config.ids.empty_conf:1 of
msgid "A parsed device.conf with nothing in it, for planning on a new host."
msgstr ""

#: ../../services.rst:101 5783fd5954a3475b87ad05c32d635e14
