msgstr ""

#: 418049f2abeb4f7891e73be38e4fd5ad apps.libraries.services.iscsi.targetcli:9
#: of
msgid ""
"create_block_backstore(device_path, name) passed device_path straight "
"through:"
msgstr ""

#: 82c5abf791fa479297e11045b9584071 apps.libraries.services.iscsi.targetcli:12
#: of
