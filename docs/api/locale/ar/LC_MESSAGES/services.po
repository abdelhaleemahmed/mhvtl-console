msgstr ""

#: apps.libraries.services.config.inventory.resolve:3
#: d49d374e5df64467899abbb3fd3ad634 of
msgid ""
"Returns None for anything not on the allowlist, and for any name that "
"resolves outside the directory - so '../../etc/shadow' is refused twice."
msgstr ""

#: 2c151ae6438a496c802cd93ad3d3d337
#: apps.libraries.services.config.inventory.list_files:1 of
msgid "Every allowed file present, fixed ones first then library_contents."
msgstr ""

#: 76ccdb5ad888429982f7488d96e79665
#: apps.libraries.services.config.inventory.read_file:1 of
