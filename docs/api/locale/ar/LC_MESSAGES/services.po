#: 042b96dd14dc4833a8e43da5e92806e3
#: apps.libraries.services.iscsi.service.IscsiService.export_library:3 of
msgid ""
"Implemented in workflow.py; see it for the step order and why the changer"
" goes out as LUN 0."
msgstr ""

#: 57227f0e7e914df3b3adaa0430c82064
#: apps.libraries.services.iscsi.service.IscsiService.unexport_library:1 of
msgid "Stop exporting a library: the target, and the devices it exported."
msgstr ""

#: apps.libraries.services.iscsi.service.IscsiService.unexport_library:3
#: d1527b6b0e544990b710eb1351cca4ca of
msgid "Implemented in workflow.py; see it for why the backstores go too."
msgstr ""

#: 69735a5f7d954338a4cc904748580d90
#: apps.libraries.services.iscsi.service.IscsiService.binding_status:1 of
