#: 351ce9d75a28403e9a388ccef1a38038 apps.libraries.services.console.units:15 of
msgid ""
"mhvtl.target                  what an operator starts and stops mhvtl-"
"load-modules.service    loads mhvtl.ko, or the TCMU modules on 1.8 "
"vtllibrary@<id>.service       one robot daemon per library "
"vtltape@<id>.service          one drive daemon per drive"
msgstr ""

#: 37a23b3966634e768b6a8540936c776e apps.libraries.services.console.units:20 of
msgid ""
"The instance ids are the device.conf ids, which is the same rule vtlcmd "
"follows."
msgstr ""

#: 3db65b5267b544328abe888c1ae49c5a
#: apps.libraries.services.console.units.UnitState:1 of
msgid "One systemd unit."
msgstr ""

#: 9084530463774013b7ef60d8481d27af
#: apps.libraries.services.console.units.MhvtlServiceStatus:1 of
msgid "The whole MHVTL unit hierarchy in one answer."
msgstr ""

#: apps.libraries.services.console.units.MhvtlServiceStatus.stale:1
#: b8831bb5400d4e5f90d312cc1449c578 of
msgid ""
"Units systemd still knows about that device.conf no longer declares. A "
"deleted library leaves these behind until the machine is rebooted."
msgstr ""

#: 2b313933222048d4b8e48a657d410fe8
#: apps.libraries.services.console.units.MhvtlServiceStatus.healthy:1 of
msgid "Everything configured is running, and the module is loaded."
msgstr ""

#: a1f95e06269a452d98b01bdacc7ccd64
#: apps.libraries.services.console.units.is_active:1 of
msgid "Is this unit running right now?"
msgstr ""

#: 1040f9a4579645768d3267451af4dc4c
#: apps.libraries.services.console.units.is_active:3 of
msgid ""
"`systemctl is-active` exits non-zero for an inactive unit, so the exit "
"code says nothing useful on its own; the word it prints is the answer."
msgstr ""

#: 59adbce7aa3e46fdbfa79db6b21ec6ff
#: apps.libraries.services.console.units.is_enabled:1 of
msgid "Will this unit start at boot?"
msgstr ""

#: 0321ef62da904f1980e84840bba5d509
#: apps.libraries.services.console.units.status:1 of
msgid "The state of every MHVTL unit."
msgstr ""

#: apps.libraries.services.console.units.status:3
#: f76e670654274dcbac62076fc5f37010 of
msgid ""
"Units are compared against device.conf so that instances left behind by a"
" deleted library are named rather than counted as failures. systemd keeps"
" a template instance loaded until the machine reboots, so a deleted "
"library otherwise shows up for ever as \"3 of 4 libraries running\"."
msgstr ""

#: apps.libraries.services.console.units.daemon_reload:1
#: e79ca5b9667e4fefbad37786ca202b57 of
msgid "Needed after unit files change - adding a library writes new instances."
msgstr ""

#: a3aea81fdad54c8cb32e37de04326c09
#: apps.libraries.services.console.units.enable:1 of
msgid "Make a unit start at boot. Creating a library writes new instances."
msgstr ""

#: 800c41e2f8d14489b7614bbfbe0e1c07
#: apps.libraries.services.console.units.library_units:1 of
msgid "The unit names one library owns: its robot, then one per drive."
msgstr ""

#: apps.libraries.services.console.units.library_units:3
#: f0c34807650f4238b930d5a4dcca1fe8 of
msgid ""
"Taking the drive ids from device.conf rather than assuming "
"library_id+1..n: a library whose drives were added and removed over time "
"has gaps, and guessing the range leaves the real units running after a "
"delete."
msgstr ""

#: 4d5ea5722b3445a9902e02d62f9b620f
#: apps.libraries.services.console.units.start_library:1 of
msgid ""
"Enable and start a library's units. Best effort: the configuration is "
"already written, so a unit that will not start is reported, not fatal."
msgstr ""

#: 0c069122db294c44b9c8b9c7ce22b42a
#: apps.libraries.services.console.units.stop_library:1 of
msgid "Stop and disable a library's units, before its configuration goes away."
msgstr ""

#: apps.libraries.services.console.units.stop_library:3
#: c8cf830dd6904e22ae30337367c1f756 of
msgid ""
"Stopping first matters: a daemon whose device.conf entry has vanished "
"logs errors until it is killed, and its unit stays loaded until the next "
"reboot."
msgstr ""

#: 4b38370aeaf5497d900bc72e31c084cd
#: apps.libraries.services.console.units.forget_library:1 of
msgid "After a library has left device.conf: drop what systemd still holds of it."
msgstr ""

#: 16e636863fcc4d899e61eeb129c8b0cd
#: apps.libraries.services.console.units.forget_library:3 of
msgid ""
"MHVTL 1.8 ships a systemd generator (mhvtl-device-conf-generator) that "
"reads device.conf at every daemon-reload and links a vtllibrary@/vtltape@"
" unit into mhvtl.target.wants for each entry - \"enabled-runtime\". "
"stop_library() reloads while the library is still in the file, so the "
"generator put the links straight back and every removed library left its "
"units enabled until the next reboot. Reloading once the entry is gone "
"removes them."
msgstr ""

#: 77372db075dd4348a6a505410e0d28c9
#: apps.libraries.services.console.units.reset_failed:1 of
msgid "Clear a failed unit's state."
msgstr ""

#: 0dcb9b6e94334a6bb51b198ceacc485c
#: apps.libraries.services.console.units.reset_failed:3 of
msgid ""
"A template instance for a library that no longer exists stays in the "
"failed list until this is called or the machine reboots, and a dashboard "
"counting failed units reports a healthy host as broken for ever."
msgstr ""

#: ab28cbd1e5e94fae88d71686df987604
#: apps.libraries.services.console.units.all_vtl_units:1 of
msgid "Every loaded vtllibrary@ and vtltape@ instance, running or not."
msgstr ""

#: 5007cc552d9840de93f802312ef2e011
#: apps.libraries.services.console.units.all_vtl_units:3 of
msgid ""
"Includes instances systemd still knows about after their device.conf "
"entry has gone, which is exactly what looking for orphans needs."
msgstr ""

#: apps.libraries.services.console.units.instance_id:1
#: ffdb223d83534af1ae35588ae3f2df03 of
msgid "The device.conf id in a template instance name, or None."
msgstr ""

#: 7547981df909469495fa92bf6d5c489c
#: apps.libraries.services.console.units.pids_of:1 of
msgid "The pids systemd still associates with a unit."
msgstr ""

#: 85f284451afd41c298acd3ea41507d55
#: apps.libraries.services.console.units.pids_of:3 of
msgid ""
"Read from systemctl rather than found by pattern: the version this "
"replaces ran `pkill -9 -f \"vtltape.*-q<id>\"`, which matches on a "
"command line and so matches anything else that happens to contain that "
"text - including, during this refactor, the shell that ran it."
msgstr ""

#: apps.libraries.services.console.units.kill_lingering:1
#: d987a29594b544708a62d3e74b265fff of
msgid "SIGKILL the processes a stopped unit left behind, and only those."
msgstr ""

#: 98adb187d618459a8249c5fdc91f1699
#: apps.libraries.services.console.units.kill_lingering:3 of
msgid ""
"A daemon whose device.conf entry has been removed does not always exit on"
" `systemctl stop`, and it holds the message queue the next library with "
"that id would use. Each pid is checked against /proc before it is "
"signalled, so a pid that has already exited and been reused is not killed"
" in its successor's place."
msgstr ""

#: apps.libraries.services.console.units.restart_library:1
#: e00058f303cf456992aaa3bfc3aa6d39 of
msgid "Restart one library's robot, or - with no library - the whole target."
msgstr ""

#: 22742ae27e1b4d18a063d661836bae39
#: apps.libraries.services.console.units.restart_library:3 of
msgid ""
"A library that will not restart is reported, never escalated. This used "
"to fall back to restarting the target, on the grounds that a new unit "
"file is unknown until daemon-reload; but the daemon-reload runs first "
"anyway, and vtllibrary@ is a template, so an instance needs no file of "
"its own. What the fallback did in practice was restart every other "
"library on the host - a job running on one lost its drive, and every "
"iSCSI export was left bound to devices that no longer existed - because "
"one of them had failed."
msgstr ""

