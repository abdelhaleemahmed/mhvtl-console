"Returns None when the name is not allowed or the file does not exist, so "
"a caller can tell \"not permitted\" from \"empty\"."
msgstr ""

#: 0db2f5ef90a948acbb00b34f7be6df5f
#: apps.libraries.services.config.inventory.export_zip:1 of
