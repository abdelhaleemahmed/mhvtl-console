#: 80a669b8ce6e47bf894e18027e4dbdfe
#: apps.libraries.services.iscsi.service.IscsiService.set_generate_node_acls:1
#: of
msgid "Let any initiator attach, or require an ACL."
msgstr ""

#: 600531c4c20d48498731b6a2ca609228
#: apps.libraries.services.iscsi.service.IscsiService.set_generate_node_acls:3
#: of
msgid ""
"Turning this on removes the access control on a target, so it is worth an"
" explicit call rather than a flag buried in a form."
