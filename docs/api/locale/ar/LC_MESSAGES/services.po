#: ../../services.rst:494 1c5cbd04db814f5b8fb81a2f636224a4
#: 7511267fdc8a422c931e72a308a606d3 apps.libraries.services.iscsi.parsing:1 of
msgid "Reading LIO's configuration: saveconfig.json and `targetcli ls`."
msgstr ""

#: apps.libraries.services.iscsi.parsing:3 c2dff09b318c423e8fb87946fadf618f of
msgid ""
"Moved from iscsi_service.py:_parse_targets_from_config, "
"_parse_targets_from_ls, _parse_backstores_from_config and "
"_parse_backstores_from_ls. The module docstring in service.py called this"
" \"around 400 lines\"; it is closer to 150, and the delay was for "
"fixtures rather than for size."
msgstr ""

#: 3d2547dbef504d238d180b92476cc1fa apps.libraries.services.iscsi.parsing:8 of
msgid "Two formats, and they are not equivalent:"
msgstr ""

#: 7cca368ee7534d519c02f755e59e2b84 apps.libraries.services.iscsi.parsing:10 of
msgid "/etc/target/saveconfig.json   the authority. JSON, complete, and what"
msgstr ""

#: 55e78c79ed664b26bbbc3df27c983d8c apps.libraries.services.iscsi.parsing:11 of
msgid "targetctl restores from at boot."
msgstr ""

#: 5a19df1d81ed4e71ae3bbda60b8882da apps.libraries.services.iscsi.parsing:12 of
msgid "targetcli ls                  a tree drawn for a human, with the fields"
msgstr ""

#: 6b78346e3ea347709b9d85a0526b62a4 apps.libraries.services.iscsi.parsing:13 of
msgid ""
"padded out by dots. Everything it prints is in the JSON; the reverse is "
"not true."
msgstr ""

#: apps.libraries.services.iscsi.parsing:16 b641555aac75488d8991be486cc64d4d of
msgid ""
"The JSON is read first and the tree only when it cannot be. Worth knowing"
" that the two can disagree about the running system: on the host these "
"fixtures came from, saveconfig.json describes three pscsi backstores and "
"three LUNs while the live tree has none. A pscsi backstore names a "
"/dev/sgN path, those numbers are reassigned when the SCSI modules reload,"
" and the backstore does not come back. So the JSON is the authority on "
"what was configured, not on what is exported right now."
msgstr ""

#: 210bbfc5f75246d89ff977a275d9abab
#: apps.libraries.services.iscsi.parsing.TPG_RE:1 of
msgid ""
"`  |   o- tpg1 ......... [gen-acls, no-auth]` - the tag is part of the "
"name."
msgstr ""

#: 866148e44b9e4d058bbdf0b9236804c9
#: apps.libraries.services.iscsi.parsing.IQN_RE:1 of
msgid "library10 ..... [TPGs: 1]`"
msgstr ""

#: 43a29bb9362c465faebfd46156efe9d0
#: apps.libraries.services.iscsi.parsing.IQN_RE:3 of
msgid "`  | o- iqn.2026-04.com.mhvtl"
msgstr ""

#: 109297643a824020a83a117538d9472d
#: apps.libraries.services.iscsi.parsing.PLUGIN_RE:1 of
msgid "0]`"
msgstr ""

#: 695e765e33a44827b31d636517d826a0
#: apps.libraries.services.iscsi.parsing.PLUGIN_RE:3 of
msgid "`  | o- block ..... [Storage Objects"
msgstr ""

#: apps.libraries.services.iscsi.parsing.ENTRY_RE:1
#: f2383cfb154947c9ba8640b46f9fb622 of
msgid "the name is what follows ``o-`` up to the padding dots."
msgstr ""

#: apps.libraries.services.iscsi.parsing.ENTRY_RE:3
#: cde7ac4c5a7245bcbb45cf11a7dd2357 of
msgid "Any tree entry"
msgstr ""

#: apps.libraries.services.iscsi.parsing.parse_config:1
#: b2a9645414d74e8d9a6c1fccf99485a0 of
msgid "The whole saved configuration. Returns empty lists on unreadable JSON."
msgstr ""

#: apps.libraries.services.iscsi.parsing.parse_config:3
#: d3d40c5234664c2289ce5499a79a87d0 of
msgid ""
"A malformed file is reported and treated as \"nothing configured\" rather"
" than raised: this is read on a status page, and a status page that 500s "
"tells an operator less than one saying the configuration cannot be read."
msgstr ""

#: ae046303605a4550a45eb6a7e68b55e6
#: apps.libraries.services.iscsi.parsing.targets_from_config:1 of
msgid "iSCSI targets, their TPGs, LUNs, ACLs and portals."
msgstr ""

#: 54307e898aef482ab8bc47dde358842d
#: apps.libraries.services.iscsi.parsing.backstores_from_config:1 of
msgid "Storage objects, whatever plugin backs them."
msgstr ""

#: 7770a204fec94a65b01f94f9b39b167f
#: apps.libraries.services.iscsi.parsing.targets_from_ls:1 of
msgid "Targets from the printed tree, used when the JSON cannot be read."
msgstr ""

#: 41a8d8020d714a67bdf1dc2e7f3d9c09
#: apps.libraries.services.iscsi.parsing.targets_from_ls:3 of
msgid ""
"Two fixes over the version this replaces: the TPG tag is read from `tpg2`"
" rather than assumed to be 1, and a TPG is only attached while an IQN "
"line has been seen, so `[TPGs: 1]` on the target's own line no longer "
"creates a phantom TPG."
msgstr ""

#: apps.libraries.services.iscsi.parsing.backstores_from_ls:1
#: b712c80f6ca14fa79ab164889e1680b1 of
msgid "Backstores from the printed tree."
msgstr ""

#: apps.libraries.services.iscsi.parsing.backstores_from_ls:3
#: b7a0bbe317fa4ae3826062b5c573769d of
msgid ""
"Only entries nested under a plugin heading count. The version this "
"replaces kept the last plugin it saw for the rest of the file, so given a"
" full `ls` it reported every target and portal as a backstore."
msgstr ""

#: ../../services.rst:502 1d977ea89a46469d904e698578898f17
msgid "``remap``"
msgstr ""

#: ../../services.rst:504 02a858ef675746438532936f0f49c728
#: apps.libraries.services.iscsi.remap:1 f6d520269b56437687662b4882786e20 of
msgid ""
"Keeping saved pscsi backstores pointed at the right devices across "
"reboots."
msgstr ""

#: 754389add96a483a9c6463c5a32685f6 apps.libraries.services.iscsi.remap:3 of
msgid ""
"A pscsi backstore is saved in /etc/target/saveconfig.json by device node "
"- /dev/sg5 - and target.service restores it by that node at boot. SCSI "
"generic numbers are assigned in probe order, which changes when the "
"machine reboots or the modules reload. After the reboot during step 9 the"
" library10 target's LUN 0, saved as \"lib10_changer\", came back as "
"library 20's robot, on a target open to any initiator."
msgstr ""

#: 37dee597d74c456aa88e8ed93d4756d6 apps.libraries.services.iscsi.remap:10 of
msgid ""
"This module rewrites the saved nodes before target.service reads them. It"
" runs from mhvtl-iscsi-remap.service, ordered After=mhvtl.target and "
"Before=target.service, so the wrong mapping is never live at all."
msgstr ""

#: 8f082f3e6d2c4181a6b077e5def6af7d apps.libraries.services.iscsi.remap:14 of
msgid "The backstore name is the mapping, so no extra state is kept:"
msgstr ""

#: apps.libraries.services.iscsi.remap:16 b8001b3b35c24f33a33da3f8bd77d254 of
msgid ""
"lib<L>_changer    the changer of library L lib<L>_drive<N>   library L's "
"Nth drive, counting from 0 in id order"
msgstr ""

#: apps.libraries.services.iscsi.remap:19 d33928d136bb4687b189e19d92ce33bd of
msgid ""
"That is the convention iscsi/workflow.export_library and `mhvtl iscsi "
"export` use. A backstore whose name does not follow it is left alone and "
"reported: this module does not guess what an operator meant by a name it "
"did not create."
msgstr ""

#: 3d4d184b6d054b80a700d0884c457bf5 apps.libraries.services.iscsi.remap:23 of
msgid ""
"A device that is expected but not visible - its daemon has not started - "
"is withheld: its backstore, the LUNs that use it and the ACL mappings to "
"those LUNs are taken out of the configuration target.service restores, "
"and recorded in the withheld file (bindings.WITHHELD) so they can be put "
"back once the device exists - by the next restart of that library, or Re-"
"bind. Leaving it in would have target.service open its old /dev/sgN, "
"which after a reboot can be another library's device. Exporting nothing "
"is recoverable; exporting the wrong robot is how tapes get overwritten."
msgstr ""

#: 06707f73da7c446c9406801a6503245d
#: apps.libraries.services.iscsi.remap.NAME_RE:1 of
msgid "lib10_changer, lib10_drive0 - the names export_library gives backstores."
msgstr ""

#: 7770b394697c4fada1aa7afb6f082af1
#: apps.libraries.services.iscsi.remap.Change:1 of
msgid "One backstore, where it points, and where it should."
msgstr ""

#: apps.libraries.services.iscsi.remap.expected_addresses:1
#: e352e6e40a3f4f4cabda867ac350ec7b of
msgid "Backstore name -> the (channel, target, lun) device.conf gives it."
msgstr ""

#: a43c603b82c94b38901ee6429276f1e3 apps.libraries.services.iscsi.remap.plan:1
#: of
msgid "What each saved pscsi backstore should point at now."
msgstr ""

#: apps.libraries.services.iscsi.remap.plan:3 cb6553926d614f9f9f08cd2eb3ce16f8
#: of
msgid ""
"Pure: takes the parsed saveconfig, the parsed device.conf and the devices"
" the kernel reports, and says what would change."
msgstr ""

#: apps.libraries.services.iscsi.remap.apply:1 cde28e98b69f4a98a4307c72c7be020a
#: of
msgid ""
"A copy of the saved configuration with the planned nodes written in, and "
"the withheld backstores taken out with their LUNs and ACL mappings."
msgstr ""

#: apps.libraries.services.iscsi.remap.withheld_entries:1
#: fc00c7aa909e45a1a3df67c07b72e569 of
msgid ""
"What it takes to put each withheld backstore back: where its device lives"
" and every LUN and ACL mapping that used it."
msgstr ""

#: apps.libraries.services.iscsi.remap.wait_for_devices:1
#: e759fbabef444addb255f73d51c879d6 of
msgid "Discover devices, waiting until every declared address is visible."
msgstr ""

#: 6f29d96ae1884d6d84240b02ddcee989
#: apps.libraries.services.iscsi.remap.wait_for_devices:3 of
msgid ""
"The 1.8 daemons add their units after mhvtl.target reports started, so "
"the first look can be incomplete. Returns whatever is visible at the "
"deadline; plan() leaves anything still missing alone."
msgstr ""

#: 2ffd8330ff0042008b4eff740f52d595 apps.libraries.services.iscsi.remap.remap:1
#: of
msgid "Point every saved pscsi backstore at the device its name means."
msgstr ""

#: 4a55f1ba284448ad812cb668b634f631 apps.libraries.services.iscsi.remap.remap:3
#: of
msgid ""
"Backs up saveconfig.json beside itself before writing, and writes only "
"when something changes. Does not touch the running target: at boot this "
"runs before target.service, and by hand the caller decides when to "
"restore."
msgstr ""

#: ../../services.rst:514 17618186cfe64d4b83e0704156683d32
#: apps.libraries.services.iscsi.service:1 d54d5c568b404bba875aa4eb1e06c51c of
msgid "iSCSI orchestration: status, targets, LUNs, ACLs, exporting a library."
msgstr ""

#: apps.libraries.services.iscsi.service:3 ed744199dcf64fe798c12d9e0a103671 of
msgid ""
"Mutations go through targetcli.py, so the IQN and device-path checks "
"described there apply to every one of them. Reading goes through "
"parsing.py, which walks LIO's two formats: /etc/target/saveconfig.json "
"first and the `targetcli ls` tree when the JSON cannot be read. Both are "
"pinned against real output from a host with a library exported, the way "
"the device.conf and mtx parsers are."
msgstr ""

#: 2b94429273454c7c9c6b1c9f6766370b apps.libraries.services.iscsi.service:9 of
msgid ""
"export_library still delegates: it is a multi-step sequence - a backstore"
" per device, a target, a LUN per backstore - and it belongs in a workflow"
" module next to create_library_workflow rather than being inlined here."
msgstr ""

#: 5ee65f9dbf144c74a330fe8b7c7c30d9 apps.libraries.services.iscsi.service:13 of
msgid ""
"What this module owns is the shape of the answer: every method returns a "
"ServiceResult from core.results rather than iscsi_service.py's own rival "
"class."
msgstr ""

#: 161cd15ce6274e9dbce0372f729df61f
#: apps.libraries.services.iscsi.service.CONFIG_PATH:1 of
msgid "Where targetctl saves and restores the LIO configuration."
msgstr ""

#: 7f23bf0ad8d24c218744b07483972b90
#: apps.libraries.services.iscsi.service.SERVICE_UNIT:1 of
