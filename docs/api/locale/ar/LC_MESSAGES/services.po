msgid ""
"There the device path lands in the revision column and every later field "
"shifts. Vendor and model are taken from the fixed columns lsscsi pads to,"
" and the /dev nodes are found by looking for them, so a spaced model no "
"longer matters."
msgstr ""

#: 9066a6b17f5b4c50886b057197405c79
#: apps.libraries.services.scsi.lsscsi.LINE_RE:1 of
