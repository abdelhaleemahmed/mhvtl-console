#: 1e25ea42bfaa406aa2a19b17e2737351 apps.libraries.services.iscsi.targetcli:3
#: of
msgid ""
"Moved from the command sites in iscsi_service.py, with two validations "
"added. Both are about the same thing: targetcli exports block devices to "
"the network, and an argument that reaches it unchecked is a mistake with "
"reach."
msgstr ""

#: 93bdd048d2dd4cbb845ecf3713e7c551 apps.libraries.services.iscsi.targetcli:7
#: of
