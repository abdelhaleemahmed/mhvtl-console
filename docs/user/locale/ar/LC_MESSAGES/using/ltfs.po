msgstr ""

#: ../../using/ltfs.rst:34 65dab2c5b3ee41c99a5000b7acd8efc2
msgid "``ltfs`` opens the cartridge *already in a drive* as a filesystem"
msgstr ""

#: ../../using/ltfs.rst:35 b03d755a06bf43c0ab607f6da6af0e43
msgid "Where"
msgstr ""

#: ../../using/ltfs.rst:36 60b45d5bceb24b68bc658ec19b283ee7
msgid "Operator → Mount and Unmount, ``mhvtl op mount``"
msgstr ""

#: ../../using/ltfs.rst:37 70a6e99e08564b6a9fdb0dcc9acb13ca
