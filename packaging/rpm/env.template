# MHVTL GUI Environment Configuration
# /etc/mhvtl-gui/env

# Django Settings
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# ... and the name the browser uses, which is also the https origin:
# ALLOWED_HOSTS=localhost,127.0.0.1,mhvtl.example.com

# Database (SQLite is used by default)
# DB_PATH=/var/lib/mhvtl-gui/db.sqlite3

# Static and Media Files
STATIC_ROOT=/var/www/mhvtl/static/
MEDIA_ROOT=/var/www/mhvtl/media/

# Logging
LOG_DIR=/var/log/mhvtl/

# MHVTL Configuration
MHVTL_PRODUCTION_MODE=True
MHVTL_CONFIG_DIR=/etc/mhvtl/
MHVTL_HOME_DIR=/opt/mhvtl/
MHVTL_ENABLE_SERVICE_CONTROL=True

# HTTPS
#
# The installer puts nginx in front with a certificate, so this is on: the
# site redirects to https, and the session and CSRF cookies are sent over
# https only. HSTS is a year.
#
# Serving over plain HTTP instead? Set HTTPS=0. Leave it at 1 and the cookies
# are never sent, so nobody can log in.
HTTPS=1

# Each part can still be set on its own for an unusual arrangement:
# SECURE_SSL_REDIRECT=True
# CSRF_COOKIE_SECURE=True
# SESSION_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# HTTPS_PORT=8443                      # only when nginx is not on 443; this is
#                                      # the port the browser sees, and Django
#                                      # compares the whole origin including it
# CSRF_TRUSTED_ORIGINS=https://mhvtl.example.com:8443

# Email Settings (optional)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
